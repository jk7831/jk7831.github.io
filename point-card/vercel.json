{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/Vignesh", "destination": "/index.html" },
    { "source": "/vignesh", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)\\.vcf", "headers": [
      { "key": "Content-Type", "value": "text/vcard; charset=utf-8" },
      { "key": "Content-Disposition", "value": "inline; filename=\"Vignesh - Point Academy.vcf\"" }
    ] }
  ]
}
