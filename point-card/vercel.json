{
  "rewrites": [
    {
      "source": "/Vignesh",
      "destination": "/"
    },
    {
      "source": "/vignesh",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Vignesh Hariharan - Point Academy.vcf\""
        }
      ]
    }
  ]
}